{
  "compilerOptions": {
    "jsx": "react-jsx", // Для React 17+ (автоматический импорт JSX)
    "jsxImportSource": "react", // Указывает на источник JSX-трансформации
    // Другие важные настройки:
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true
  },
  "include": ["src"]
}
